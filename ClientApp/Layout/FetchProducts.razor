@page "/fetchproducts"
@page "/products"

@using FullStackApp.Shared.Models

<PageTitle>InventoryHub</PageTitle>

@*
    FetchProducts.razor
    - Uses the dedicated ProductService to fetch data from /api/productlist.
    - Renders the actual product records returned by the server, including the nested Category object.
*@

@inject ClientApp.Services.IProductService ProductService

<h3>Product List</h3>

@if (loading)
{
    <p>Loading products...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (products is { Length: > 0 })
{
    <div class="list-group">
        @foreach (var product in products)
        {
            <div class="list-group-item">
                <h5>@product.Name</h5>
                <p class="mb-1">Id: @product.Id</p>
                <p class="mb-1">Price: $@product.Price</p>
                <p class="mb-1">Stock: @product.Stock</p>
                <p class="mb-0">Category: @(product.Category?.Name ?? "N/A")</p>
            </div>
        }
    </div>
}
else
{
    <p>No products found from /api/productlist.</p>
}

@code {
    private Product[] products = Array.Empty<Product>();
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ProductService.GetProductsAsync();
            if (products.Length == 0)
            {
                errorMessage = "The API returned no product elements.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load products from /api/productlist.";
            Console.WriteLine($"FetchProducts: unexpected error: {ex.Message}");
            products = Array.Empty<Product>();
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}